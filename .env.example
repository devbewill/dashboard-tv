# Google Calendar (opzionali: senza queste variabili la sezione appuntamenti resta vuota)
# Chiave JSON di un service account con cui il calendario è condiviso ("Visualizzare tutti i dettagli").
GOOGLE_SERVICE_ACCOUNT_FILE=.secrets/google-service-account.json
# Email del calendario da leggere (non "primary": sarebbe il calendario del service account).
GOOGLE_CALENDAR_ID=
